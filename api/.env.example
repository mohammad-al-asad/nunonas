APP_NAME="Nuno Backend"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGIN_REGEX="^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$"

MONGODB_URI="mongodb://mongo:27017"
MONGODB_DB_NAME="nuno"
RUN_STARTUP_DB_SETUP=false
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=10000

JWT_SECRET_KEY="replace-with-a-strong-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
RESET_TOKEN_EXPIRE_MINUTES=15

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

AWS_REGION=""
S3_BUCKET_NAME=""
S3_PREFIX="activity-planner"
S3_PUBLIC_BASE_URL=""
# Local dev only. On EC2 leave these empty and use the instance IAM role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Demo login created by scripts/seed_demo_activity.py (admin + customer).
SEED_DEMO_EMAIL=""
SEED_DEMO_PASSWORD=""

PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
PLATFORM_ADMIN_FULL_NAME="Platform Admin"


LOYALTY_POINTS_ON_CONFIRM=50

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

